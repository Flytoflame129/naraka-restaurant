---
import { mapThemes } from "../data/mapThemes";
---

<div class="theme-switcher" aria-label="地图主题切换">
  {mapThemes.map((theme) => (
    <button type="button" data-map-theme-target={theme.key} title={`${theme.name}主题`} aria-pressed={theme.key === "juku" ? "true" : "false"}>
      {theme.name}
    </button>
  ))}
</div>

<script>
  const themeKey = "naraka-restaurant-map-theme";
  const allowedThemes = new Set(["juku", "huoluo", "longyin"]);

  function applyMapTheme(theme) {
    if (!allowedThemes.has(theme)) {
      theme = "juku";
    }

    document.documentElement.dataset.mapTheme = theme;
    try {
      window.localStorage.setItem(themeKey, theme);
    } catch (_) {}

    for (const title of document.querySelectorAll("[data-map-theme-title]")) {
      const nextTitle = title.dataset[theme];
      if (nextTitle) title.textContent = nextTitle;
    }

    for (const button of document.querySelectorAll("[data-map-theme-target]")) {
      button.setAttribute("aria-pressed", button.dataset.mapThemeTarget === theme ? "true" : "false");
    }

    window.dispatchEvent(new CustomEvent("naraka-map-theme-change", { detail: { theme } }));
  }

  function restoreMapTheme() {
    let savedTheme = null;
    try {
      savedTheme = window.localStorage.getItem(themeKey);
    } catch (_) {}
    applyMapTheme(savedTheme || document.documentElement.dataset.mapTheme || "juku");
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest("[data-map-theme-target]");
    if (!(button instanceof HTMLElement)) return;
    applyMapTheme(button.dataset.mapThemeTarget);
  });

  document.addEventListener("astro:page-load", restoreMapTheme);
</script>
