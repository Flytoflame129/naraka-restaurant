---
import { mapThemes } from "../data/mapThemes";
import { Picture } from "astro:assets";
import { mapThemeImages } from "../lib/imageAssets";

interface Props {
  theme: (typeof mapThemes)[number];
}

const { theme } = Astro.props;
---

<article class="theme-card" data-theme-card={theme.key} style={`--theme-card-accent: ${theme.accent}`}>
  <Picture
    src={mapThemeImages[theme.key]}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[384, 768]}
    sizes="(max-width: 560px) calc(100vw - 1.25rem), (max-width: 900px) 50vw, 384px"
    alt={theme.alt}
    loading="lazy"
  />
  <div class="theme-card-body">
    <p class="card-kicker">{theme.label}</p>
    <h3>{theme.name}</h3>
    <p>{theme.description}</p>
    <p class="theme-tone">{theme.tone}</p>
  </div>
</article>
