---
import { sitePath } from "../lib/site";
import { getImage, Image } from "astro:assets";
import { getImageAsset } from "../lib/imageAssets";

const { theme, items, offset } = Astro.props;
const itemsInOrder = [...items]
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({ data, asset: getImageAsset(data.image.src) }));
const options = await Promise.all(itemsInOrder.map(async ({ data, asset }) => ({
    title: data.title,
    map: data.map,
    category: data.category,
    description: data.description,
    href: sitePath(`/menu/${data.slug}/`),
    image: (await getImage({ src: asset, width: 720, height: 405, format: "webp" })).src,
    asset,
    imageAlt: data.image.alt,
  })));
const initial = options[0];
const optionsJson = JSON.stringify(options.map(({ asset: _, ...option }) => option)).replaceAll("<", "\\u003c");
---

<article
  class="daily-special-card"
  data-daily-slot
  data-offset={offset}
  data-theme-card={theme.key}
>
  <a class="daily-special-link" href={initial.href} data-daily-link>
    <Image
      src={initial.asset}
      alt={initial.imageAlt}
      width={720}
      height={405}
      format="webp"
      loading="lazy"
      data-daily-image
    />
    <div class="daily-special-copy">
      <span class="daily-special-map" data-daily-map>{initial.map}</span>
      <h3 data-daily-title>{initial.title}</h3>
      <p data-daily-description>{initial.description}</p>
      <span class="menu-item-category" data-daily-category>{initial.category}</span>
    </div>
  </a>
  <script type="application/json" data-daily-options set:html={optionsJson}></script>
</article>
