---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import LoadingIndicator from "astro-loading-indicator/component";
import { ThemeScript } from "astro-theme-toggle/components";
import { ClientRouter, fade } from "astro:transitions";
import { mapThemeImages } from "../lib/imageAssets";
import { sitePath, siteTitle } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  initialTheme?: string;
}

const {
  title = siteTitle,
  description = "NARAKA Restaurant 是《永劫无间》玩家同好创作的虚拟游戏主题餐厅站点。",
  image = "/assets/visuals/hero-main.webp",
  initialTheme = "juku",
} = Astro.props;

const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImagePath = image.startsWith("/assets/") ? sitePath(image) : image;
const socialImageUrl = new URL(socialImagePath, Astro.site ?? Astro.url.origin);
const assetVariables = [
  ["--asset-hero-main", "/assets/visuals/hero-main.webp"],
  ["--asset-theme-juku", mapThemeImages.juku.src],
  ["--asset-theme-huoluo", mapThemeImages.huoluo.src],
  ["--asset-theme-longyin", mapThemeImages.longyin.src],
]
  .map(([name, path]) => `${name}: url("${path.startsWith("/assets/") ? sitePath(path) : path}")`)
  .join(";");
---

<!doctype html>
<html lang="zh-CN" data-map-theme={initialTheme} transition:animate={fade({ duration: "180ms" })}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='8' fill='%23601015'/%3E%3Cpath d='M19 45V18h6l15 18V18h6v27h-6L25 27v18z' fill='%23d4b06a'/%3E%3C/svg%3E" />
    <ThemeScript />
    <script is:inline>
      try {
        const mapTheme = window.localStorage.getItem("naraka-restaurant-map-theme");
        if (["juku", "huoluo", "longyin"].includes(mapTheme)) {
          document.documentElement.dataset.mapTheme = mapTheme;
        }
      } catch (_) {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={`:root{${assetVariables}}`}></style>
    <ClientRouter />
    <LoadingIndicator color="var(--color-accent)" height="3px" threshold={250} animationDuration={240} />
    <script>
      import "../scripts/site-experience";
    </script>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">跳到主要内容</a>
      <Navbar />
      <main class="page-main" id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
