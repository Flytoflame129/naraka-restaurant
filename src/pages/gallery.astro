---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { galleryItems } from "../data/galleryItems";
import { sitePath } from "../lib/site";
---

<BaseLayout title="画廊" description="NARAKA Restaurant 社区作品画廊。">
  <PageHero
    eyebrow="食肆画廊"
    title="同好作品陈列架"
    lead="这里陈列玩家原创与授权作品，每一件都随作者署名和来处一同入馆。"
    compact
  >
    <a class="button secondary" href={sitePath("/submit/")}>查看投稿说明</a>
  </PageHero>

  <section class="section-tight">
    <div class="container">
      {galleryItems.length === 0 ? (
        <div class="empty-state">
          陈列架正等待第一件作品。来稿请附作者署名、作品来处、展示许可与撤稿联系方式。
        </div>
      ) : (
        <div class="info-grid">
          {galleryItems.map((item) => (
            <article class="info-card">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
              <p>{item.author} 路 {item.licenseNote}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
