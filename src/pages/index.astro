---
import { getCollection } from "astro:content";
import DailySpecialCard from "../components/DailySpecialCard.astro";
import MapThemeCard from "../components/MapThemeCard.astro";
import ThemeHeroPicture from "../components/ThemeHeroPicture.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { mapThemes } from "../data/mapThemes";
import { sitePath } from "../lib/site";

const menuItems = await getCollection("menuItems");
const dailyGroups = mapThemes.map((theme, offset) => ({
  theme,
  offset,
  items: menuItems
    .filter((item) => item.data.map === theme.name)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout title="首页" description="NARAKA Restaurant 是《永劫无间 / NARAKA: BLADEPOINT》玩家同好创作站。">
  <section class="hero hero--main">
    <ThemeHeroPicture />
    <div class="container hero-panel">
      <div class="hero-copy">
        <p class="eyebrow">无间食肆 · 今日开席</p>
        <h1
          class="hero-title"
          data-map-theme-title
          data-juku={mapThemes[0].heroTitle}
          data-huoluo={mapThemes[1].heroTitle}
          data-longyin={mapThemes[2].heroTitle}
        >{mapThemes[0].heroTitle}</h1>
        <div class="theme-intro-stack" aria-live="polite">
          {mapThemes.map((theme) => (
            <p class="lead theme-intro" data-theme-copy={theme.key}>
              {theme.heroDescription}
            </p>
          ))}
        </div>
        <div class="button-row">
          <a class="button" href={sitePath("/menu/")}>翻开菜单卷轴</a>
          <a class="button secondary" href={sitePath("/submit/")}>查看投稿委托</a>
        </div>
      </div>

      <article class="info-card" aria-label="今日席位">
        <p class="eyebrow">今日席位</p>
        <h2>无间食肆今日告示</h2>
        <div class="button-row">
          <span class="meme-badge pending">同好共创</span>
        </div>
        <p>玩家熟悉的江湖故事在这里化作一道道虚拟菜品。今日灯火已亮，请按席入座。</p>
        <p><strong>今日席面：</strong>翻菜单看招牌菜，沿地图找不同风味，再把新菜名递进后厨。</p>
        <p><strong>食肆规矩：</strong>菜名可以大胆，出处不能乱写；没有把握的传闻会留在后厨继续整理。</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">地图席位</p>
      <h2 class="section-title">三处开席，各有风味</h2>
      <p class="lead">三方水土各成一席：聚窟洲雾色温润，火罗国烈宴灼热，龙隐洞天幽光深邃。</p>
      <div class="theme-grid">
        {mapThemes.map((theme) => <MapThemeCard theme={theme} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">今日招牌</p>
      <h2 class="section-title">今日三席推荐</h2>
      <p class="lead">聚窟洲、火罗国、龙隐洞天各上一道；今日不变，明日换席。</p>
      <div class="daily-special-grid">
        {dailyGroups.map(({ theme, offset, items }) => (
          <DailySpecialCard theme={theme} offset={offset} items={items} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">江湖来帖 / 后厨接菜</p>
      <h2 class="section-title">江湖来菜，后厨接帖</h2>
      <div class="info-grid">
        <article class="info-card">
          <h3>席间故事入菜</h3>
          <p>玩家记忆里的妙语与名场面，会在后厨慢慢熬成新菜；来历尚未理清的，只作试味，不急着挂牌。</p>
        </article>
        <article class="info-card">
          <h3>后厨投稿委托</h3>
          <p>递菜谱时，请带上菜名、出处、相关角色或招式，以及图片许可。后厨核清来路后，再择席上桌。</p>
          <p><a href={sitePath("/submit/")}>前往投稿说明</a></p>
        </article>
        <article class="info-card">
          <h3>食肆上桌规矩</h3>
          <p>菜单只端已经整理好的虚拟菜品；仍在核对出处的试菜继续留在后厨，不拿半成品充数。</p>
          <p><a href={sitePath("/menu/")}>查看完整菜单</a></p>
        </article>
      </div>
    </div>
  </section>

  <script>
    function updateDailySpecials() {
      const now = new Date();
      const dayNumber = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86_400_000);

      for (const slot of document.querySelectorAll("[data-daily-slot]")) {
        if (!(slot instanceof HTMLElement)) continue;

        const optionsElement = slot.querySelector("[data-daily-options]");
        if (!(optionsElement instanceof HTMLScriptElement)) continue;

        const options = JSON.parse(optionsElement.textContent || "[]");
        if (!Array.isArray(options) || options.length === 0) continue;

        const index = (dayNumber + Number(slot.dataset.offset)) % options.length;
        const selected = options[index];
        const link = slot.querySelector("[data-daily-link]");
        const image = slot.querySelector("[data-daily-image]");
        const title = slot.querySelector("[data-daily-title]");
        const map = slot.querySelector("[data-daily-map]");
        const category = slot.querySelector("[data-daily-category]");
        const description = slot.querySelector("[data-daily-description]");

        if (link instanceof HTMLAnchorElement) link.href = selected.href;
        if (image instanceof HTMLImageElement) {
          image.srcset = "";
          image.src = selected.image;
          image.alt = selected.imageAlt;
        }
        if (title) title.textContent = selected.title;
        if (map) map.textContent = selected.map;
        if (category) category.textContent = selected.category;
        if (description) description.textContent = selected.description;
      }
    }

    document.addEventListener("astro:page-load", updateDailySpecials);
  </script>
</BaseLayout>
