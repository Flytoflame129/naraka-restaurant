---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repositoryUrl } from "../lib/site";

const issueUrl = `${repositoryUrl}/issues/new?template=dish-submission.yml`;
---

<BaseLayout title="投稿" description="向 NARAKA Restaurant 投稿菜品、梗来源或画廊作品。">
  <PageHero
    eyebrow="后厨委托书"
    title="向后厨递交新菜谱"
    lead="投稿请先把梗名、出处、关联线索、图片授权和展示许可写清楚。投稿不等于发布，维护者会先核对来源、安全风险和非官方边界。"
    compact
  >
    <a class="button" href={issueUrl}>打开 GitHub Issue Form</a>
  </PageHero>

  <section class="section-tight">
    <div class="container">
      <div class="info-grid">
        <article class="info-card">
          <h2>菜名与出处</h2>
          <p>写清楚梗名、别名、来源链接、平台、作者或发布者。没有可公开链接时，请说明无法公开的原因，并明确标注“待考证”。</p>
        </article>
        <article class="info-card">
          <h2>关联线索</h2>
          <p>尽量补充相关角色、武器、地图、操作或社区语境。拿不准就直说“不确定”，不要把猜测写成既定事实。</p>
        </article>
        <article class="info-card">
          <h2>图片授权</h2>
          <p>图片、海报、菜单设计和二创作品都要给出作者署名、来源链接、授权范围，以及是否允许本站展示。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="stats-grid">
        <article class="stat-card">
          <h3>展示许可</h3>
          <p>请直接说明是否允许在本站公开展示，是否接受裁切、缩略图和署名方式调整。</p>
        </article>
        <article class="stat-card">
          <h3>审核流程</h3>
          <p>投稿进入后厨账本后，维护者会先核来源、授权和风险，再决定是否转成公开菜品或画廊条目。</p>
        </article>
        <article class="stat-card">
          <h3>撤稿补充</h3>
          <p>后续若要补来源、修正文案或申请下架，请继续在同一条 GitHub Issue 里补充，方便留下处理记录。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="notice">
        后厨不收未授权图片、冒充官方口吻的文案、隐私泄露、开盒、引战或把未考证传闻写成事实的投稿。投稿只是委托审稿，不是自动发布。
      </div>
    </div>
  </section>
</BaseLayout>
