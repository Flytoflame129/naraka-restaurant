---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { copyrightNotice, repositoryUrl } from "../lib/site";

const issuesUrl = `${repositoryUrl}/issues`;
---

<BaseLayout title="关于" description="NARAKA Restaurant 的非官方声明、版权说明和维护规则。">
  <PageHero
    eyebrow="关于无间食肆"
    title="以一席江湖味，留住玩家故事"
    lead="无间食肆是一座由《永劫无间》玩家共同构想的虚拟餐厅。我们以菜品收录玩家交流中的故事与创意，并持续整理来源、标注二创边界。"
    compact
  />

  <section class="section-tight">
    <div class="container" data-reveal>
      <div class="info-grid">
        <article class="info-card">
          <h2>非官方立场</h2>
          <p>{copyrightNotice}</p>
          <p>无间食肆由玩家共同创作，站内菜品与故事不代表游戏官方立场。</p>
        </article>
        <article class="info-card">
          <h2>玩家故事留存</h2>
          <p>我们把玩家交流中的妙语、名场面和来处整理成册，让每一道菜既有江湖味，也能说清从何而来。</p>
        </article>
        <article class="info-card">
          <h2>虚拟餐厅包装</h2>
          <p>菜品、席位和文案都是同好包装，用来增强阅读体验，不代表真实售卖，也不直接搬运官方视觉素材。</p>
        </article>
        <article class="info-card">
          <h2>撤稿与权益路径</h2>
          <p>如果你是作者、权利人或投稿者，需要补授权、申请下架或纠正文案，请到 <a href={issuesUrl}>GitHub Issues</a> 留言，维护者会优先处理并记录结果。</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
